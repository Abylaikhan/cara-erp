{
    "config_version": 1,
    "timezone": "Asia/Almaty",
    "schedule": {
        "local_time": "07:17",
        "cron_utc": "17 2 * * *"
    },
    "source": {
        "repository": "https://github.com/Cara-ERP/promtech-erp",
        "branch": "main",
        "path": "index.html",
        "watched_paths": [
            "Index.html",
            "indexx.html",
            "indrx.html"
        ],
        "accepted_ref": {
            "commit": "c5e745cab6e2f4a26df3a8cb6b912df626236d33",
            "sha256": "e1715f8e4e2d243f6638cfbbb9005ad9e3409885c3776184b6a383d8d2586b9b",
            "basis": "ТЗ harness 1.1 от 13.10.2026; меняется только отдельным решением"
        }
    },
    "target": {
        "repository": "https://github.com/Abylaikhan/cara-erp",
        "branch": "main",
        "compose_project": "promtech-audit",
        "image": "promtech-erp-app:audit",
        "steps": [
            {
                "id": "TGT-DEPS",
                "step": "deps",
                "title": "Установка зависимостей из composer.lock и package-lock.json",
                "required": true
            },
            {
                "id": "TGT-PINT",
                "step": "pint",
                "title": "Стиль PHP (pint --test)",
                "required": true
            },
            {
                "id": "TGT-TYPES",
                "step": "types",
                "title": "Типы TypeScript/Vue (vue-tsc)",
                "required": true
            },
            {
                "id": "TGT-BUILD",
                "step": "build",
                "title": "Production-сборка (vite build)",
                "required": true
            },
            {
                "id": "TGT-TESTS",
                "step": "tests",
                "title": "Backend-тесты на изолированной PostgreSQL",
                "required": true,
                "junit": "storage/logs/junit.xml"
            },
            {
                "id": "TGT-MIGRATE",
                "step": "migrate",
                "title": "Миграции и синтетический seed на чистой PostgreSQL",
                "required": true
            },
            {
                "id": "TGT-DB",
                "step": "dbcheck",
                "title": "Подключение именно к PostgreSQL (dev и test)",
                "required": true
            },
            {
                "id": "TGT-HTTP",
                "step": "http",
                "title": "HTTP smoke: /up и /login через nginx",
                "required": true
            }
        ],
        "planned_checks": [
            {
                "id": "TGT-PHPSTAN",
                "title": "Статанализ PHP (PHPStan/Larastan)"
            },
            {
                "id": "TGT-LINT",
                "title": "Frontend lint"
            },
            {
                "id": "TGT-VITEST",
                "title": "Frontend unit-тесты (Vitest)"
            },
            {
                "id": "TGT-E2E",
                "title": "Сквозные сценарии Playwright"
            },
            {
                "id": "TGT-VISUAL",
                "title": "Визуальное сравнение с эталоном legacy"
            },
            {
                "id": "TGT-BACKUP",
                "title": "Backup → restore-check в отдельную БД"
            }
        ],
        "ephemeral_volumes": [
            "pgdata",
            "pgdata-test"
        ],
        "dev_compose_project": "promtech-erp"
    },
    "paths": {
        "work": ".local-audit",
        "reports": "docs/daily",
        "changelog": "docs/DAILY-CHANGELOG.md",
        "state": "docs/audit/state.json",
        "findings": "docs/audit/findings.json",
        "coverage": "docs/coverage/requirements.csv"
    },
    "images": {
        "node": "node:24.21.0-bookworm-slim"
    },
    "limits": {
        "git_timeout_s": 180,
        "inventory_timeout_s": 120,
        "inventory_memory": "1g",
        "target_step_timeout_s": 900
    },
    "ai_review": {
        "enabled": false,
        "reason_disabled": "Нет ключа Anthropic API и согласованного бюджета для автоматического запуска"
    },
    "sheets": {
        "local_config": "~/.config/promtech/harness.local.json",
        "api_key_file": "~/.config/promtech/google-sheets-api-key",
        "service_account_file": "~/.config/promtech/sheets-sa.json"
    },
    "modules": {
        "page-dashboard": "M01 Дашборд",
        "page-mrp": "M02 Производство",
        "page-warehouse": "M03 Склад",
        "page-purchases": "M04 Закупки",
        "page-esf": "M05 Входящие ЭСФ",
        "page-suppliers": "M06 Поставщики",
        "page-catalog": "M07 Каталог",
        "page-customers": "M08 Покупатели",
        "page-sales": "M09 Продажи",
        "page-crm": "M10 CRM",
        "page-finance": "M11 Финансы",
        "page-money": "M12 Деньги",
        "page-channels": "M13 Центры прибыли",
        "page-expense_cats": "M14 Статьи расходов",
        "page-money_salon": "M15 Касса салона",
        "page-reconcile": "M16 Сверка с офисом",
        "page-hr": "M17 Сотрудники",
        "page-wages": "M18 Сдельная оплата",
        "page-payroll": "M19 Зарплатная ведомость",
        "page-accruals": "M20 Начисления ЗП",
        "page-salon_report": "M21 Отчёт салонов",
        "page-mycabinet": "M22 Мой кабинет",
        "page-ai": "M23 AI Ассистент"
    }
}
